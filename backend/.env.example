# Chạy thử bằng SQLite. MySQL/XAMPP: mysql+pymysql://smartcode:password@127.0.0.1:3306/smartcode?charset=utf8mb4
DATABASE_URL=sqlite:///./data/smartcode.db
AUTO_SEED=true
DEMO_PASSWORD=SmartCode@123
# Điền khóa ngẫu nhiên dài >= 32 ký tự khi triển khai. Nếu để trống, app tạo và lưu data/jwt.key.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Chỉ sử dụng Judge0 do bạn quản lý/cấu hình. Không tự gửi code tới dịch vụ công cộng.
JUDGE0_URL=
JUDGE0_TOKEN=
JUDGE0_PYTHON_ID=71
JUDGE0_JAVA_ID=62
JUDGE0_JAVASCRIPT_ID=63
# AI gợi ý code chạy cục bộ bằng Ollama (không gửi code tới dịch vụ AI công cộng).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=75
# QR chuyển khoản: chỉ VPBank. Có thể nhập 2 trường này trên trang Admin > Giao dịch.
VPBANK_ACCOUNT_NUMBER=
VPBANK_ACCOUNT_NAME=
# Chỉ áp dụng cho MoMo/ZaloPay: sandbox hoặc production.
# QR VPBank luôn là chuyển khoản thật vào tài khoản đã cấu hình.
PAYMENT_MODE=sandbox
# Origin HTTPS công khai trỏ đến backend để ví gửi kết quả, không có dấu / cuối.
PAYMENT_PUBLIC_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# Password recovery. Without SMTP, email is stored privately in data/mail_outbox.
PUBLIC_APP_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartCode <noreply@smartcode.local>
